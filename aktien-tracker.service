[Unit]
Description=Aktien-Tracker (Planspiel Boerse)
After=network-online.target
Wants=network-online.target

[Service]
User=planspiel
WorkingDirectory=/opt/planspiel/aktien-tracker
Environment=HOST=0.0.0.0 PORT=8080 NO_BROWSER=1 PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
